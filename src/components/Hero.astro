---
/**
 * Hero — Section pembuka
 * Nama, tagline, CTA, meta info, animated background
 */

import { t, defaultLang } from '../i18n/ui';

interface Props {
  lang?: 'id' | 'en' | 'ar';
}

const { lang = defaultLang } = Astro.props;

// Split nama untuk styling baris kedua
const nameLine1 = 'Nafi Ainun';
const nameLine2 = "Na'im";
---

<section class="hero" id="hero">
  <!-- Background: Animated Gradient Mesh + Grain -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__blob hero__blob--primary"></div>
    <div class="hero__blob hero__blob--accent"></div>
    <div class="hero__blob hero__blob--highlight"></div>
    <div class="hero__grain"></div>
  </div>

  <!-- Content -->
  <div class="hero__inner container">
    <div class="hero__content">

      <!-- Greeting label -->
      <span class="hero__greeting">
        <span class="hero__greeting-wave">👋</span>
        {t(lang, 'hero.greeting')}
      </span>

      <!-- Nama -->
      <h1 class="hero__name">
        <span class="hero__name-line">{nameLine1}</span>
        <span class="hero__name-line hero__name-line--accent">{nameLine2}</span>
      </h1>

      <!-- Tagline -->
      <p class="hero__tagline">{t(lang, 'hero.tagline')}</p>

      <!-- CTA Buttons -->
      <div class="hero__cta">
        <a href="#projects" class="btn btn--primary">
          {t(lang, 'hero.cta.projects')}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#contact" class="btn btn--ghost">
          {t(lang, 'hero.cta.contact')}
        </a>
      </div>

      <!-- Meta info -->
      <div class="hero__meta">
        <span class="hero__meta-item">
          <span class="hero__meta-icon">📍</span>
          {t(lang, 'hero.meta.location')}
        </span>
        <span class="hero__meta-divider">·</span>
        <span class="hero__meta-item">
          <span class="hero__meta-icon">🌐</span>
          {t(lang, 'hero.meta.languages')}
        </span>
        <span class="hero__meta-divider">·</span>
        <span class="hero__meta-item hero__meta-item--status">
          <span class="hero__meta-dot"></span>
          {t(lang, 'hero.meta.status')}
        </span>
      </div>

    </div>

    <!-- Visual kanan (blob organik dulu, nanti diganti foto) -->
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__visual-frame">
        <div class="hero__visual-placeholder">
          <span class="hero__visual-initial">N</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     HERO — Styles
     ============================================================ */

  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: var(--space-32) var(--space-20);
  }

  /* ---------- Background Layer ---------- */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    will-change: transform;
  }

  .hero__blob--primary {
    width: 500px;
    height: 500px;
    background: var(--color-primary);
    top: -10%;
    right: -5%;
    animation: blobFloat 18s ease-in-out infinite;
  }

  .hero__blob--accent {
    width: 420px;
    height: 420px;
    background: var(--color-accent);
    bottom: 10%;
    right: 15%;
    animation: blobFloat 22s ease-in-out infinite reverse;
  }

  .hero__blob--highlight {
    width: 320px;
    height: 320px;
    background: var(--color-highlight);
    top: 30%;
    left: -8%;
    opacity: 0.35;
    animation: blobFloat 26s ease-in-out infinite;
  }

  @keyframes blobFloat {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -20px) scale(1.05);
    }
    66% {
      transform: translate(-20px, 30px) scale(0.95);
    }
  }

  /* Grain texture */
  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.035;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' /%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  /* ---------- Inner Layout ---------- */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    align-items: center;
    width: 100%;
  }

  .hero__content {
    max-width: 640px;
  }

  /* ---------- Greeting ---------- */
  .hero__greeting {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-xs);
  }

  .hero__greeting-wave {
    display: inline-block;
    animation: wave 2.5s ease-in-out infinite;
    transform-origin: 70% 70%;
  }

  @keyframes wave {
    0%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60%, 100% { transform: rotate(0deg); }
  }

  /* ---------- Nama ---------- */
  .hero__name {
    font-family: var(--font-heading);
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6) 0;
    color: var(--color-text);
  }

  .hero__name-line {
    display: block;
  }

  .hero__name-line--accent {
    color: var(--color-primary);
    position: relative;
    display: inline-block;
  }

  /* Underline hand-drawn di bawah nama kedua */
  .hero__name-line--accent::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15em;
    height: 0.18em;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    opacity: 0.7;
    transform: scaleX(0);
    transform-origin: left;
    animation: underlineGrow 900ms var(--transition-slow) 400ms ease-out forwards;
  }

  @keyframes underlineGrow {
    to { transform: scaleX(1); }
  }

  /* ---------- Tagline ---------- */
  .hero__tagline {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-10) 0;
    max-width: 56ch;
  }

  /* ---------- CTA ---------- */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  /* Button base */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    border: 1.5px solid transparent;
    cursor: pointer;
    line-height: 1;
  }

  .btn--primary {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .btn--primary:hover {
    background: var(--color-primary-hover);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: var(--shadow-primary);
  }

  .btn--primary svg {
    transition: transform var(--transition-base);
  }

  .btn--primary:hover svg {
    transform: translateX(4px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .btn--ghost:hover {
    background: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  /* ---------- Meta Info ---------- */
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__meta-icon {
    font-size: 0.95em;
  }

  .hero__meta-divider {
    color: var(--color-border-strong);
  }

  .hero__meta-item--status {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .hero__meta-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--color-success);
    border-radius: 50%;
    position: relative;
  }

  .hero__meta-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  /* ---------- Visual (Blob placeholder) ---------- */
  .hero__visual {
    display: none;
    position: relative;
  }

  .hero__visual-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%;
    background: linear-gradient(135deg, var(--color-primary-soft) 0%, var(--color-accent-soft) 100%);
    overflow: hidden;
    animation: blobMorph 12s ease-in-out infinite;
    box-shadow: var(--shadow-lg);
  }

  @keyframes blobMorph {
    0%, 100% {
      border-radius: 40% 60% 55% 45% / 50% 45% 55% 50%;
    }
    50% {
      border-radius: 55% 45% 40% 60% / 45% 55% 45% 55%;
    }
  }

  .hero__visual-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__visual-initial {
    font-family: var(--font-heading);
    font-size: 8rem;
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    opacity: 0.5;
    line-height: 1;
  }

  /* ---------- Responsive ---------- */

  /* Tablet & Desktop: 2-column layout */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.4fr 1fr;
    }

    .hero__visual {
      display: block;
    }
  }

  /* Large Desktop: bigger visual */
  @media (min-width: 1200px) {
    .hero__inner {
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-20);
    }
  }

  /* Mobile: sesuaikan padding & ukuran */
  @media (max-width: 639px) {
    .hero {
      padding-block: var(--space-24) var(--space-16);
      min-height: auto;
    }

    .hero__blob {
      filter: blur(60px);
      opacity: 0.35;
    }

    .hero__blob--primary {
      width: 280px;
      height: 280px;
    }

    .hero__blob--accent {
      width: 240px;
      height: 240px;
    }

    .hero__blob--highlight {
      width: 180px;
      height: 180px;
    }

    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }
  }

  /* ---------- RTL Support ---------- */
  :global([dir="rtl"]) .hero__content {
    text-align: right;
  }

  :global([dir="rtl"]) .hero__cta {
    flex-direction: row-reverse;
  }

  :global([dir="rtl"]) .hero__name-line--accent::after {
    transform-origin: right;
  }
</style>