---
/**
 * Skills — Keahlian, dikelompokkan per kategori
 */

import { t, defaultLang } from '../i18n/ui';
import { skillGroups } from '../data/skills';
import Tag from './ui/Tag.astro';

interface Props {
  lang?: 'id' | 'en' | 'ar';
}

const { lang = defaultLang } = Astro.props;
---

<section class="skills section" id="skills">
  <div class="container">

    <header class="skills__header" data-reveal>
      <span class="section-label">{t(lang, 'skills.label')}</span>
      <h2 class="skills__heading">{t(lang, 'skills.heading')}</h2>
    </header>

    <div class="skills__grid">
      {skillGroups.map((group) => (
        <div class="skills-group" data-reveal>
          <div class="skills-group__head">
            <span class="skills-group__icon" aria-hidden="true">{group.icon}</span>
            <h3 class="skills-group__title">
              {t(lang, `skills.group.${group.key}`)}
            </h3>
          </div>
          <div class="skills-group__tags">
            {group.items.map((item) => (
              <Tag variant={group.variant} size="md">{item}</Tag>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .skills__header {
    margin-bottom: var(--space-12);
    max-width: 50ch;
  }

  .skills__heading {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .skills__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .skills-group {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition: all var(--transition-base);
  }

  .skills-group:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .skills-group__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .skills-group__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--color-surface-alt);
    border-radius: var(--radius-md);
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .skills-group__title {
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin: 0;
  }

  .skills-group__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease-out, transform 700ms ease-out;
  }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const revealElements = document.querySelectorAll('#skills [data-reveal]');

  if (revealElements.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );
    revealElements.forEach((el) => observer.observe(el));
  } else {
    revealElements.forEach((el) => el.classList.add('is-revealed'));
  }
</script>