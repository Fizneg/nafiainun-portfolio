---
/**
 * Experience — Section pengalaman
 * 4 sub-section: Sedang Berjalan, Profesional, Magang, Part-time
 */

import { t, defaultLang } from '../i18n/ui';
import { experiences, getInitials } from '../data/experiences';
import Tag from './ui/Tag.astro';
import Badge from './ui/Badge.astro';

interface Props {
  lang?: 'id' | 'en' | 'ar';
}

const { lang = defaultLang } = Astro.props;

// Filter per kategori
const current = experiences.filter((e) => e.category === 'current');
const professional = experiences.filter((e) => e.category === 'professional');
const internships = experiences.filter((e) => e.category === 'internship');
const parttime = experiences.filter((e) => e.category === 'parttime');
---

<section class="exp section" id="experience">
  <div class="container">

    <!-- Header -->
    <header class="exp__header" data-reveal>
      <span class="section-label">{t(lang, 'exp.label')}</span>
      <h2 class="exp__heading">{t(lang, 'exp.heading')}</h2>
    </header>

    <!-- ============================================================
         SUB 1 — SEDANG BERJALAN
         ============================================================ -->
    <div class="exp__sub" data-reveal>
      <h3 class="exp__sub-title">
        <span class="exp__sub-dot"></span>
        {t(lang, 'exp.current.title')}
      </h3>

      <div class="exp__grid exp__grid--3">
        {current.map((exp) => (
          <article class="exp-card exp-card--small">
            <div class="exp-card__top">
              <div class="exp-card__logo" aria-hidden="true">
                {getInitials(exp.organization)}
              </div>
              {exp.isActive && (
                <Badge variant="active">{t(lang, 'exp.active')}</Badge>
              )}
            </div>
            <h4 class="exp-card__role">{exp.role}</h4>
            <p class="exp-card__org">{exp.organization}</p>
            <p class="exp-card__desc">{exp.description}</p>
          </article>
        ))}
      </div>
    </div>

    <!-- ============================================================
         SUB 2 — PENGALAMAN PROFESIONAL (FEATURED)
         ============================================================ -->
    {professional.length > 0 && (
      <div class="exp__sub" data-reveal>
        <h3 class="exp__sub-title">{t(lang, 'exp.professional.title')}</h3>

        {professional.map((exp) => (
          <article class="exp-card exp-card--featured">
            <div class="exp-card__featured-head">
              <div class="exp-card__logo exp-card__logo--lg" aria-hidden="true">
                {getInitials(exp.organization)}
              </div>
              <div class="exp-card__featured-meta">
                <h4 class="exp-card__role exp-card__role--lg">{exp.role}</h4>
                <p class="exp-card__org exp-card__org--lg">{exp.organization}</p>
                <div class="exp-card__meta-row">
                  <span>{exp.period}</span>
                  {exp.location && (
                    <>
                      <span class="exp-card__meta-divider">·</span>
                      <span>{exp.location}</span>
                    </>
                  )}
                  {exp.type && (
                    <>
                      <span class="exp-card__meta-divider">·</span>
                      <Tag variant="default">{exp.type}</Tag>
                    </>
                  )}
                </div>
              </div>
            </div>

            <div class="exp-card__featured-body">
              <p>{exp.description}</p>

              {exp.details && exp.details.length > 0 && (
                <ul class="exp-card__details">
                  {exp.details.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              )}

              {exp.hasDocumentation && (
                <a href="#" class="exp-card__link">
                  {t(lang, 'exp.view_detail')}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <!-- ============================================================
         SUB 3 — MAGANG
         ============================================================ -->
    {internships.length > 0 && (
      <div class="exp__sub" data-reveal>
        <h3 class="exp__sub-title">{t(lang, 'exp.internship.title')}</h3>

        <div class="exp__grid exp__grid--3">
          {internships.map((exp) => (
            <article class="exp-card exp-card--small">
              <div class="exp-card__top">
                <div class="exp-card__logo" aria-hidden="true">
                  {getInitials(exp.organization)}
                </div>
                {exp.type && (
                  <Tag variant="default">{exp.type}</Tag>
                )}
              </div>
              <h4 class="exp-card__role">{exp.role}</h4>
              <p class="exp-card__org">{exp.organization}</p>
              <p class="exp-card__period">{exp.period}</p>
              <p class="exp-card__desc">{exp.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    <!-- ============================================================
         SUB 4 — PART-TIME
         ============================================================ -->
    {parttime.length > 0 && (
      <div class="exp__sub" data-reveal>
        <h3 class="exp__sub-title">{t(lang, 'exp.parttime.title')}</h3>

        {parttime.map((exp) => (
          <article class="exp-card exp-card--wide">
            <div class="exp-card__wide-inner">
              <div class="exp-card__logo exp-card__logo--lg" aria-hidden="true">
                {getInitials(exp.organization)}
              </div>
              <div class="exp-card__wide-content">
                <div class="exp-card__wide-head">
                  <h4 class="exp-card__role">{exp.role}</h4>
                  {exp.type && <Tag variant="default">{exp.type}</Tag>}
                </div>
                <p class="exp-card__org">{exp.organization}</p>
                <p class="exp-card__period">{exp.period}</p>
                <p class="exp-card__desc">{exp.description}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

  </div>
</section>

<style>
  /* ============================================================
     EXPERIENCE — Section
     ============================================================ */

  .exp__header {
    margin-bottom: var(--space-12);
    max-width: 50ch;
  }

  .exp__heading {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }

  /* ---------- Sub-section ---------- */
  .exp__sub {
    margin-bottom: var(--space-16);
  }

  .exp__sub:last-child {
    margin-bottom: 0;
  }

  .exp__sub-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6) 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px dashed var(--color-border-strong);
  }

  .exp__sub-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--color-success);
    border-radius: 50%;
    position: relative;
  }

  .exp__sub-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-success);
    animation: subDotPulse 2s ease-in-out infinite;
  }

  @keyframes subDotPulse {
    0% { transform: scale(1); opacity: 1; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  /* ---------- Grids ---------- */
  .exp__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .exp__grid--3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .exp__grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ============================================================
     EXP CARD — Base
     ============================================================ */

  .exp-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition: all var(--transition-base);
    position: relative;
  }

  .exp-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  /* ---------- Card: Small (grid 3 kolom) ---------- */
  .exp-card--small {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
  }

  .exp-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  /* ---------- Logo / Inisial ---------- */
  .exp-card__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--color-primary-soft), var(--color-accent-soft));
    color: var(--color-text);
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-lg);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .exp-card__logo--lg {
    width: 56px;
    height: 56px;
    font-size: var(--text-h4);
  }

  /* ---------- Role & Org ---------- */
  .exp-card__role {
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--color-text);
    margin: 0;
  }

  .exp-card__role--lg {
    font-size: var(--text-h3);
  }

  .exp-card__org {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    margin: 0;
  }

  .exp-card__org--lg {
    font-size: var(--text-body);
  }

  .exp-card__period {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0;
  }

  .exp-card__desc {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: var(--space-2) 0 0 0;
  }

  /* ============================================================
     EXP CARD — Featured (Profesional)
     ============================================================ */

  .exp-card--featured {
    padding: var(--space-8);
  }

  .exp-card__featured-head {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }

  .exp-card__featured-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }

  .exp-card__meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .exp-card__meta-divider {
    color: var(--color-border-strong);
  }

  .exp-card__featured-body {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .exp-card__featured-body p {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin: 0 0 var(--space-5) 0;
    max-width: 65ch;
  }

  .exp-card__details {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .exp-card__details li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  .exp-card__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
  }

  .exp-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    transition: gap var(--transition-base);
  }

  .exp-card__link:hover {
    gap: var(--space-3);
    color: var(--color-primary-hover);
  }

  /* ============================================================
     EXP CARD — Wide (Part-time)
     ============================================================ */

  .exp-card--wide {
    padding: var(--space-8);
  }

  .exp-card__wide-inner {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .exp-card__wide-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    min-width: 0;
  }

  .exp-card__wide-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .exp-card__wide-content .exp-card__desc {
    margin-top: var(--space-3);
  }

  /* ============================================================
     Reveal Animation
     ============================================================ */

  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease-out, transform 700ms ease-out;
  }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ============================================================
     Mobile adjustments
     ============================================================ */

  @media (max-width: 639px) {
    .exp-card--featured,
    .exp-card--wide {
      padding: var(--space-6);
    }

    .exp-card__featured-head {
      flex-direction: column;
    }

    .exp-card__wide-inner {
      flex-direction: column;
    }
  }

  /* ============================================================
     RTL
     ============================================================ */

  :global([dir="rtl"]) .exp-card__details li {
    padding-left: 0;
    padding-right: var(--space-6);
  }

  :global([dir="rtl"]) .exp-card__details li::before {
    left: auto;
    right: 0;
  }

  :global([dir="rtl"]) .exp-card__link:hover {
    flex-direction: row-reverse;
  }
</style>

<script>
  // Reveal on scroll — sama seperti About
  const revealElements = document.querySelectorAll('#experience [data-reveal]');

  if (revealElements.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -60px 0px',
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  } else {
    revealElements.forEach((el) => el.classList.add('is-revealed'));
  }
</script>