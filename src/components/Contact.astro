---
/**
 * Contact — Section kontak dengan background gradient
 */

import { t, defaultLang } from '../i18n/ui';
import { socials } from '../data/socials';

interface Props {
  lang?: 'id' | 'en' | 'ar';
}

const { lang = defaultLang } = Astro.props;
const emailUrl = socials.find((s) => s.key === 'email')?.url || '#';
---

<section class="contact" id="contact">
  <!-- Background gradient -->
  <div class="contact__bg" aria-hidden="true">
    <div class="contact__blob contact__blob--1"></div>
    <div class="contact__blob contact__blob--2"></div>
  </div>

  <div class="contact__inner container">

    <header class="contact__header" data-reveal>
      <span class="contact__label">{t(lang, 'contact.label')}</span>
      <h2 class="contact__heading">{t(lang, 'contact.heading')}</h2>
      <p class="contact__subheading">{t(lang, 'contact.subheading')}</p>
    </header>

    <!-- Social cards grid -->
    <div class="contact__grid" data-reveal>
      {socials.map((s) => (
        <a
          href={s.url}
          class="contact-card"
          target={s.key === 'email' ? undefined : '_blank'}
          rel={s.key === 'email' ? undefined : 'noopener noreferrer'}
        >
          <span class="contact-card__icon" aria-hidden="true">{s.icon}</span>
          <div class="contact-card__content">
            <span class="contact-card__label">{s.label}</span>
            <span class="contact-card__value">{s.value}</span>
          </div>
          <svg class="contact-card__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      ))}
    </div>

    <!-- Big CTA -->
    <div class="contact__cta-wrap" data-reveal>
      <a href={emailUrl} class="contact__cta">
        {t(lang, 'contact.send')}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* ============================================================
     CONTACT — Section
     ============================================================ */

  .contact {
    position: relative;
    padding-block: var(--space-24);
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .contact { padding-block: var(--space-32); }
  }

  /* ---------- Background ---------- */
  .contact__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .contact__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.35;
  }

  .contact__blob--1 {
    width: 500px;
    height: 500px;
    background: var(--color-primary);
    top: -20%;
    left: -10%;
    animation: contactFloat 20s ease-in-out infinite;
  }

  .contact__blob--2 {
    width: 420px;
    height: 420px;
    background: var(--color-accent);
    bottom: -15%;
    right: -5%;
    animation: contactFloat 24s ease-in-out infinite reverse;
  }

  @keyframes contactFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -30px) scale(1.05); }
  }

  /* ---------- Inner ---------- */
  .contact__inner {
    position: relative;
    z-index: 1;
  }

  /* ---------- Header ---------- */
  .contact__header {
    text-align: center;
    max-width: 56ch;
    margin: 0 auto var(--space-16);
  }

  .contact__label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .contact__heading {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
  }

  .contact__subheading {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ---------- Social Grid ---------- */
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .contact__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ---------- Card ---------- */
  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: all var(--transition-base);
    position: relative;
  }

  .contact-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .contact-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--color-surface-alt);
    border-radius: var(--radius-md);
    font-size: 1.125rem;
    flex-shrink: 0;
    transition: background var(--transition-base);
  }

  .contact-card:hover .contact-card__icon {
    background: var(--color-primary-soft);
  }

  .contact-card__content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .contact-card__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-card__value {
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-card__arrow {
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .contact-card:hover .contact-card__arrow {
    color: var(--color-primary);
    transform: translate(2px, -2px);
  }

  /* ---------- CTA ---------- */
  .contact__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: var(--space-12);
  }

  .contact__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-8);
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    box-shadow: var(--shadow-md);
  }

  .contact__cta:hover {
    background: var(--color-primary-hover);
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: var(--shadow-primary);
  }

  .contact__cta svg {
    transition: transform var(--transition-base);
  }

  .contact__cta:hover svg {
    transform: translateX(4px);
  }

  /* ---------- Reveal ---------- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms ease-out, transform 700ms ease-out;
  }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .contact__blob { animation: none; }
  }
</style>

<script>
  const revealElements = document.querySelectorAll('#contact [data-reveal]');

  if (revealElements.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
    );
    revealElements.forEach((el) => observer.observe(el));
  } else {
    revealElements.forEach((el) => el.classList.add('is-revealed'));
  }
</script>