---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout
  title="Nafi Ainun Na'im — Portfolio"
  description="Portfolio Nafi Ainun Na'im. Lulusan Public Relations, Document Control Specialist, kini freelance Arabic tutor, tour guide, dan translator."
  lang="id"
>
  <main class="container" style="padding-block: var(--space-16);">
    
    <span class="section-label">Test BaseLayout</span>
    
    <h1>
      Halo, BaseLayout <span style="color: var(--color-primary);">berhasil</span>.
    </h1>

    <p style="margin-top: var(--space-6); max-width: 60ch;">
      Kalau kamu melihat halaman ini dengan judul di tab browser 
      <strong>"Nafi Ainun Na'im — Portfolio"</strong>, berarti 
      BaseLayout sudah bekerja dengan benar.
    </p>

    <div style="margin-top: var(--space-8);">
      <a href="#" style="
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-4) var(--space-6);
        background: var(--color-primary);
        color: #FFF;
        border-radius: var(--radius-lg);
        font-weight: var(--weight-semibold);
      ">
        Tombol Test
      </a>
    </div>

  </main>
</BaseLayout>