---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test Design Tokens — Nafi Ainun Na'im</title>
  </head>
  <body>
    <main class="container" style="padding-block: var(--space-16);">
      
      <span class="section-label">Test Halaman</span>
      
      <h1>
        Halo, ini test <span style="color: var(--color-primary);">design tokens</span>.
      </h1>

      <p style="margin-top: var(--space-6); max-width: 60ch;">
        Kalau kamu melihat halaman ini dengan font Bricolage Grotesque untuk
        heading, dan Plus Jakarta Sans untuk body, serta warna orange cerah
        di kata <em>design tokens</em>, berarti semuanya bekerja dengan benar.
      </p>

      <div style="display: flex; gap: var(--space-4); margin-top: var(--space-8); flex-wrap: wrap;">
        <div style="width: 80px; height: 80px; background: var(--color-primary); border-radius: var(--radius-lg);"></div>
        <div style="width: 80px; height: 80px; background: var(--color-accent); border-radius: var(--radius-lg);"></div>
        <div style="width: 80px; height: 80px; background: var(--color-highlight); border-radius: var(--radius-lg);"></div>
        <div style="width: 80px; height: 80px; background: var(--color-text); border-radius: var(--radius-lg);"></div>
        <div style="width: 80px; height: 80px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-lg);"></div>
      </div>

      <div style="margin-top: var(--space-8); display: flex; gap: var(--space-4); flex-wrap: wrap;">
        <a href="#" style="
          display: inline-flex;
          align-items: center;
          gap: var(--space-2);
          padding: var(--space-4) var(--space-6);
          background: var(--color-primary);
          color: #FFF;
          border-radius: var(--radius-lg);
          font-weight: var(--weight-semibold);
        ">
          Tombol Primary
        </a>
        <a href="#" style="
          display: inline-flex;
          align-items: center;
          gap: var(--space-2);
          padding: var(--space-4) var(--space-6);
          background: transparent;
          color: var(--color-text);
          border: 1.5px solid var(--color-border-strong);
          border-radius: var(--radius-lg);
          font-weight: var(--weight-medium);
        ">
          Tombol Ghost
        </a>
      </div>

    </main>
  </body>
</html>