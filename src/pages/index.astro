import Projects from '../components/Projects.astro';
import Certifications from '../components/Certifications.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import '../styles/global.css';

const lang = 'id';
---

<BaseLayout
  title="Nafi Ainun Na'im — Portfolio"
  description="Portfolio Nafi Ainun Na'im. Lulusan Public Relations, Document Control Specialist, kini freelance Arabic tutor, tour guide, dan translator."
  lang={lang}
>
  <Hero lang={lang} />
  <About lang={lang} />
  <Experience lang={lang} />
  <Projects lang={lang} />
  <Certifications lang={lang} />
  <Skills lang={lang} />
  <Contact lang={lang} />
</BaseLayout>